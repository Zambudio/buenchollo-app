{% extends "_layout.html.j2" %}
{% import "_components.html.j2" as ui with context %}

{% block content %}
        <tr>
          <td class="px" bgcolor="#ffffff" style="background:#ffffff;border:1px solid #e2e8f0;border-top:0;border-radius:0 0 16px 16px;padding:32px 28px 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td>
                  {{ ui.eyebrow("Nueva propuesta") }}
                  <h1 class="h1" style="margin:10px 0 0;font-family:{{ t.sans }};font-size:25px;line-height:33px;font-weight:700;letter-spacing:-.5px;color:{{ t.text }};">{{ title }}</h1>
                  {% if image_url %}
                  <p style="margin:16px 0 0;"><img src="{{ image_url }}" width="160" alt="" style="display:block;max-width:100%;height:auto;border-radius:8px;border:1px solid #e2e8f0;"></p>
                  {% endif %}
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:18px;">
                    <tr>
                      <td bgcolor="#f8fafc" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px 20px;font-family:{{ t.sans }};font-size:14px;line-height:22px;color:{{ t.text_soft }};">
                        <strong>Precio:</strong> {{ price }}{% if previous_price %} (antes {{ previous_price }}){% endif %}<br>
                        {% if store %}<strong>Tienda:</strong> {{ store }}<br>{% endif %}
                        <strong>Autor:</strong> {{ author }}
                      </td>
                    </tr>
                  </table>
                  {% if warnings %}
                  <p style="margin:12px 0 0;font-family:{{ t.sans }};font-size:15px;line-height:24px;color:{{ t.text_soft }};"><strong>Avisos:</strong></p>
                  <ul style="margin:6px 0 0;padding-left:20px;font-family:{{ t.sans }};font-size:14px;line-height:22px;color:{{ t.text_soft }};">
                    {% for w in warnings %}
                    <li>{{ w }}</li>
                    {% endfor %}
                  </ul>
                  {% endif %}
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;">
                    <tr><td width="100%">{{ ui.button(review_url, "Revisar propuesta", variant="primary", full=true) }}</td></tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
{% endblock %}