{#- Layout común de todos los correos. Tablas + estilos inline: es lo único que
    Gmail, Outlook y Apple Mail pintan igual. Los colores salen del tema
    (`t`, ver application/theme.py) para mantenerlos en un solo sitio. -#}
{% import "_components.html.j2" as ui with context %}
<!doctype html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{{ subject }}</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root { color-scheme: dark; supported-color-schemes: dark; }
  body { margin: 0 !important; padding: 0 !important; width: 100% !important; background: {{ t.bg }}; }
  table, td { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
  img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
  a { color: {{ t.cyan }}; }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
  u + #body a { color: inherit; text-decoration: none; }
  .btn a:hover { opacity: .9; }
  @media only screen and (max-width: 620px) {
    .px { padding-left: 18px !important; padding-right: 18px !important; }
    .stack { display: block !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; }
    .stack-gap { padding-bottom: 16px !important; }
    .h1 { font-size: 25px !important; line-height: 32px !important; }
    .price { font-size: 26px !important; }
    .hide-sm { display: none !important; }
    .full { width: 100% !important; }
    .stat-box { padding: 11px 9px 10px !important; }
    .stat-num { font-size: 16px !important; line-height: 20px !important; }
    .stat-label { font-size: 8px !important; letter-spacing: 1px !important; }
  }
</style>
</head>
<body id="body" style="margin:0;padding:0;background:{{ t.bg }};">
{#- Texto de vista previa (lo que se ve junto al asunto en la bandeja). Los
    caracteres invisibles evitan que el cliente rellene con el cuerpo. -#}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:{{ t.bg }};opacity:0;">{{ preheader }}{% for _ in range(60) %}&#8204;&nbsp;{% endfor %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ t.bg }}" style="background:{{ t.bg }};">
  <tr>
    <td align="center" style="padding:28px 12px 36px;">
      <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">

        {#- Cabecera: línea cian (como la og-image) + logo + wordmark. -#}
        <tr>
          <td style="background:{{ t.cyan }};height:3px;line-height:3px;font-size:0;border-radius:3px 3px 0 0;">&nbsp;</td>
        </tr>
        <tr>
          <td class="px" bgcolor="{{ t.card }}" style="background:{{ t.card }};border:1px solid {{ t.border }};border-top:0;border-radius:0 0 16px 16px;padding:18px 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="52" valign="middle" style="width:52px;">
                  <a href="{{ links.home }}" target="_blank" style="text-decoration:none;">
                    <img src="{{ assets.logo }}" width="52" height="52" alt="BuenChollo Tech" style="display:block;width:52px;height:52px;border-radius:50%;">
                  </a>
                </td>
                <td valign="middle" style="padding-left:14px;">
                  <a href="{{ links.home }}" target="_blank" style="text-decoration:none;font-family:{{ t.mono }};font-size:17px;font-weight:700;letter-spacing:1.5px;color:{{ t.text }};">BUENCHOLLO<span style="color:{{ t.cyan }};">_TECH</span></a>
                  <div style="font-family:{{ t.mono }};font-size:11px;letter-spacing:.5px;color:{{ t.muted }};padding-top:3px;">Chollos y ofertas de tecnología</div>
                </td>
                {% if header_tag %}
                <td class="hide-sm" align="right" valign="middle" style="font-family:{{ t.mono }};font-size:11px;font-weight:700;letter-spacing:2px;color:{{ t.cyan }};white-space:nowrap;">&gt; {{ header_tag }}</td>
                {% endif %}
              </tr>
            </table>
          </td>
        </tr>

        {{ ui.spacer(18) }}

        {% block content %}{% endblock %}

        {#- Pie: identidad, motivo del envío y enlaces de gestión/baja. -#}
        {{ ui.spacer(8) }}
        <tr>
          <td class="px" align="center" style="padding:24px 28px 0;">
            <img src="{{ assets.logo_small }}" width="32" height="32" alt="" style="display:block;width:32px;height:32px;border-radius:50%;margin:0 auto 12px;opacity:.85;">
            <div style="font-family:{{ t.mono }};font-size:12px;font-weight:700;letter-spacing:1.5px;color:{{ t.text }};">BUENCHOLLO<span style="color:{{ t.cyan }};">_TECH</span></div>
            {% if footer_reason %}
            <p style="margin:12px 0 0;font-family:{{ t.sans }};font-size:12px;line-height:19px;color:{{ t.muted }};">{{ footer_reason }}</p>
            {% endif %}
            {% if footer_links %}
            <p style="margin:12px 0 0;font-family:{{ t.mono }};font-size:11px;line-height:20px;letter-spacing:.5px;">
              {%- for label, url in footer_links -%}
              {% if not loop.first %}<span style="color:{{ t.border_strong }};">&nbsp;&nbsp;·&nbsp;&nbsp;</span>{% endif %}<a href="{{ url }}" target="_blank" style="color:{{ t.cyan }};text-decoration:none;">{{ label }}</a>
              {%- endfor -%}
            </p>
            {% endif %}
            {% if show_affiliate_note %}
            <p style="margin:14px 0 0;font-family:{{ t.sans }};font-size:11px;line-height:17px;color:{{ t.faint }};">Precios y disponibilidad en el momento del envío; pueden cambiar en cualquier momento. Como afiliados de Amazon, obtenemos ingresos por las compras adscritas que cumplen los requisitos aplicables.</p>
            {% endif %}
            <p style="margin:14px 0 0;font-family:{{ t.sans }};font-size:11px;line-height:17px;color:{{ t.faint }};">
              <a href="{{ links.home }}" target="_blank" style="color:{{ t.faint }};text-decoration:none;">buenchollotech.com</a>
              &nbsp;·&nbsp; <a href="mailto:{{ contact_email }}" style="color:{{ t.faint }};text-decoration:none;">{{ contact_email }}</a>
            </p>
          </td>
        </tr>

      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
</table>
</body>
</html>
