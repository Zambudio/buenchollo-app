{#- Layout común de todos los correos. Tablas + estilos inline: compatible con
    Gmail, Outlook, Apple Mail y Yahoo. Estilo limpio, luminoso y elegante. -#}
{% import "_components.html.j2" as ui with context %}
<!doctype html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<title>{{ subject }}</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: {{ t.canvas }} !important; -webkit-font-smoothing: antialiased; }
  table, td { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
  img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
  a { color: {{ t.cta }}; text-decoration: none; }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
  u + #body a { color: inherit; text-decoration: none; }
  .btn a:hover { opacity: .92; }
  @media only screen and (max-width: 620px) {
    .px { padding-left: 18px !important; padding-right: 18px !important; }
    .stack { display: block !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; }
    .stack-gap { padding-bottom: 14px !important; }
    .h1 { font-size: 23px !important; line-height: 30px !important; }
    .price { font-size: 25px !important; }
    .hide-sm { display: none !important; }
    .full { width: 100% !important; }
    .btn-mobile-gap { padding-bottom: 12px !important; }
    .footer-bar-stack { display: block !important; width: 100% !important; text-align: center !important; }
    .footer-bar-stack-gap { padding-bottom: 14px !important; }
  }
</style>
</head>
<body id="body" bgcolor="{{ t.canvas }}" style="margin:0;padding:0;background-color:{{ t.canvas }};">
{#- Texto de vista previa en bandeja de entrada -#}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:{{ t.canvas }};opacity:0;">{{ preheader }}{% for _ in range(60) %}&#8204;&nbsp;{% endfor %}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ t.canvas }}" style="background-color:{{ t.canvas }};">
  <tr>
    <td align="center" style="padding:28px 12px 40px;">
      <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">

        {#- CABECERA ELEGANTE SOBRE BLANCO (Limpia, luminosa, sin bloques negros) -#}
        <tr>
          <td style="background:{{ t.header_line }};height:3px;line-height:3px;font-size:0;border-radius:16px 16px 0 0;">&nbsp;</td>
        </tr>
        <tr>
          <td class="px" bgcolor="{{ t.header_bg }}" style="background:{{ t.header_bg }};border:1px solid {{ t.border }};border-top:0;border-bottom:1px solid {{ t.border_subtle }};padding:18px 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="46" valign="middle" style="width:46px;">
                  <a href="{{ links.home }}" target="_blank" style="text-decoration:none;">
                    <img src="{{ assets.logo }}" width="44" height="44" alt="BuenChollo Tech" style="display:block;width:44px;height:44px;border-radius:50%;border:1px solid {{ t.border }};">
                  </a>
                </td>
                <td valign="middle" style="padding-left:14px;">
                  <a href="{{ links.home }}" target="_blank" style="text-decoration:none;font-family:{{ t.mono }};font-size:16px;font-weight:700;letter-spacing:1px;color:{{ t.text }};">BUENCHOLLO<span style="color:{{ t.cta }};">_TECH</span></a>
                  <div style="font-family:{{ t.sans }};font-size:12px;color:{{ t.muted }};padding-top:2px;">Chollos y ofertas de tecnología</div>
                </td>
                {% if header_tag %}
                <td class="hide-sm" align="right" valign="middle" style="font-family:{{ t.mono }};font-size:11px;font-weight:700;letter-spacing:1.5px;color:{{ t.cta }};white-space:nowrap;">&gt; {{ header_tag }}</td>
                {% endif %}
              </tr>
            </table>
          </td>
        </tr>

        {#- CUERPO DEL MENSAJE (inyectado por la plantilla específica) -#}
        {% block content %}{% endblock %}

        {{ ui.spacer(18) }}

        {#- BARRA INFERIOR DE ACCESOS RÁPIDOS (Estilo elegante pastel, sin negro) -#}
        <tr>
          <td class="px" bgcolor="{{ t.footer_banner }}" style="background:{{ t.footer_banner }};border:1px solid {{ t.footer_border }};border-radius:12px;padding:16px 20px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td class="footer-bar-stack footer-bar-stack-gap" valign="middle" align="left">
                  <a href="{{ links.home }}" target="_blank" style="text-decoration:none;font-family:{{ t.mono }};font-size:13px;font-weight:700;color:{{ t.text_soft }};">
                    <span style="color:{{ t.cta }};font-size:15px;vertical-align:middle;">🌐</span>&nbsp; buenchollotech.com
                  </a>
                </td>
                <td class="footer-bar-stack" valign="middle" align="right">
                  <a href="{{ links.telegram }}" target="_blank" style="display:inline-block;padding:9px 18px;background:{{ t.telegram }};border-radius:8px;font-family:{{ t.mono }};font-size:12px;font-weight:700;letter-spacing:1px;color:#ffffff;text-decoration:none;text-transform:uppercase;white-space:nowrap;box-shadow:0 1px 2px rgba(0,0,0,0.05);">
                    <img src="{{ assets.telegram }}" width="15" height="15" alt="" style="display:inline-block;vertical-align:middle;margin-right:6px;border-radius:50%;">CANAL TELEGRAM
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {{ ui.spacer(10) }}

        {#- PIE LEGAL E INFORMATIVO SOBRE FONDO CLARO -#}
        <tr>
          <td class="px" align="center" style="padding:14px 20px 0;">
            {% if footer_reason %}
            <p style="margin:0;font-family:{{ t.sans }};font-size:12px;line-height:18px;color:{{ t.muted }};">{{ footer_reason }}</p>
            {% endif %}
            {% if footer_links %}
            <p style="margin:10px 0 0;font-family:{{ t.sans }};font-size:12px;line-height:20px;">
              {%- for label, url in footer_links -%}
              {% if not loop.first %}<span style="color:{{ t.border_strong }};">&nbsp;&nbsp;·&nbsp;&nbsp;</span>{% endif %}<a href="{{ url }}" target="_blank" style="color:{{ t.cta }};text-decoration:none;font-weight:600;">{{ label }}</a>
              {%- endfor -%}
            </p>
            {% endif %}
            {% if show_affiliate_note %}
            <p style="margin:12px 0 0;font-family:{{ t.sans }};font-size:11px;line-height:17px;color:{{ t.faint }};">Precios y disponibilidad en el momento del envío; pueden cambiar en cualquier momento. Como afiliados de Amazon, obtenemos ingresos por las compras adscritas que cumplen los requisitos aplicables.</p>
            {% endif %}
            <p style="margin:12px 0 0;font-family:{{ t.sans }};font-size:11px;line-height:17px;color:{{ t.faint }};">
              © 2026 BuenChollo Tech. Todos los derechos reservados.
            </p>
          </td>
        </tr>

      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
</table>
</body>
</html>