{#- Correos de cuenta de Supabase Auth (confirmación, recuperar contraseña,
    cambio de email...). Se renderiza UNA vez con `scripts/build_auth_email_templates.py`
    y el resultado conserva las variables de Supabase (`{{ .ConfirmationURL }}`,
    `{{ .Token }}`...), que llegan aquí como texto literal. -#}
{% extends "_layout.html.j2" %}
{% import "_components.html.j2" as ui with context %}
{% block content %}
        {#- TARJETA PRINCIPAL DEL MENSAJE SOBRE BLANCO -#}
        <tr>
          <td class="px" bgcolor="#ffffff" style="background:#ffffff;border:1px solid {{ t.border }};border-top:0;border-radius:0 0 16px 16px;padding:34px 28px 32px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center">
                  <div style="font-size:36px;line-height:42px;">{{ icon }}</div>
                  <div style="padding-top:14px;">{{ ui.eyebrow(eyebrow) }}</div>
                  <h1 class="h1" style="margin:10px 0 0;font-family:{{ t.sans }};font-size:26px;line-height:34px;font-weight:700;letter-spacing:-.5px;color:{{ t.text }};">{{ title }}</h1>
                  <p style="margin:14px auto 0;max-width:440px;font-family:{{ t.sans }};font-size:15px;line-height:24px;color:{{ t.text_soft }};">{{ intro }}</p>

                  {% if detail %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:18px auto 0;">
                    <tr>
                      <td bgcolor="{{ t.card_subtle }}" style="background:{{ t.card_subtle }};border:1px solid {{ t.border }};border-radius:10px;padding:12px 18px;font-family:{{ t.mono }};font-size:13px;line-height:22px;color:{{ t.text_soft }};">{{ detail|safe }}</td>
                    </tr>
                  </table>
                  {% endif %}

                  {% if code %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:22px auto 0;">
                    <tr>
                      <td bgcolor="#f0f7ff" style="background:#f0f7ff;border:1px dashed {{ t.cta }};border-radius:12px;padding:16px 28px;font-family:{{ t.mono }};font-size:32px;font-weight:700;letter-spacing:10px;color:{{ t.cta }};">{{ code }}</td>
                    </tr>
                  </table>
                  {% endif %}

                  {% if action_url %}
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:26px auto 0;max-width:320px;width:100%;">
                    <tr><td width="100%" style="width:100%;">{{ ui.button(action_url, button_label, variant="primary", full=true) }}</td></tr>
                  </table>
                  {% endif %}

                  {% if expiry_note %}
                  <p style="margin:18px 0 0;font-family:{{ t.mono }};font-size:12px;line-height:19px;color:{{ t.muted }};">{{ expiry_note }}</p>
                  {% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {% if action_url %}
        {{ ui.spacer(14) }}
        <tr>
          <td class="px" style="padding:0 24px;font-family:{{ t.sans }};font-size:12px;line-height:19px;color:{{ t.muted }};text-align:center;">
            ¿El botón no funciona? Copia y pega este enlace en tu navegador:<br>
            <a href="{{ action_url }}" target="_blank" style="color:{{ t.cta }};word-break:break-all;font-weight:600;">{{ action_url }}</a>
          </td>
        </tr>
        {% endif %}

        {{ ui.spacer(14) }}
        {#- NOTA DE SEGURIDAD OBLIGATORIA -#}
        <tr>
          <td class="px" bgcolor="#f8fafc" style="background:#f8fafc;border:1px solid {{ t.border }};border-radius:12px;padding:16px 20px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="28" valign="top" style="width:28px;font-size:18px;line-height:22px;">🛡️</td>
                <td valign="top" style="font-family:{{ t.sans }};font-size:13px;line-height:20px;color:{{ t.muted }};">{{ safety_note }}</td>
              </tr>
            </table>
          </td>
        </tr>
{% endblock %}